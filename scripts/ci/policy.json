{
  "checks": ["backend-types", "backend-tests", "adapter-tests"],
  "documentationFiles": ["README.md", "CONTEXT.md", "backend/README.md", "adapter/maa/README.md", "scripts/ci/README.md", ".github/pull_request_template.md"],
  "documentationDirectories": ["docs/overview/", "docs/engineering/", "docs/adr/", "docs/archive/"],
  "rules": [
    { "file": ".github/workflows/check-backend-types.yml", "checks": ["backend-types"] },
    { "file": ".github/workflows/check-backend-tests.yml", "checks": ["backend-tests"] },
    { "file": ".github/workflows/check-adapter-tests.yml", "checks": ["adapter-tests"] },
    { "prefix": "backend/", "checks": ["backend-types", "backend-tests"] },
    { "prefix": "adapter/maa/", "checks": ["backend-tests", "adapter-tests"] }
  ]
}
